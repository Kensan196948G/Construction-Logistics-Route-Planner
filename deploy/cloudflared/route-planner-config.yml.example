# Construction Logistics Route Planner production-hostname Cloudflare Tunnel
# config (example). Copy to ~/.cloudflared/route-planner-config.yml and fill
# the tunnel id / credentials path from
# `cloudflared tunnel create route-planner`.
#
# NOTE: the application is still in PoC/sample mode; this hostname serves the
# sample-mode MVP for review, not production data.
tunnel: <TUNNEL_ID>
credentials-file: /home/<USER>/.cloudflared/<TUNNEL_ID>.json

originRequest:
  connectTimeout: 30s
  noHappyEyeballs: false

ingress:
  - hostname: route-planner.mirai-dx-platform.com
    service: http://localhost:18017
  - service: http_status:404
