[Unit]
Description=Construction Logistics Route Planner Web UI
Documentation=file:%h/Projects/Mirai-DX-Project/Construction-Logistics-Route-Planner/README.md
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/Mirai-DX-Project/Construction-Logistics-Route-Planner
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/Projects/Mirai-DX-Project/Construction-Logistics-Route-Planner
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 18017
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
